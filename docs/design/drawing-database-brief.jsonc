// Drawing Database brief v1 — TQ-CMMS
// Versi terstruktur dari docs/DRAWING-DATABASE-PRD.md. Bila berbeda, PRD yang berlaku.
// Sumber: repo platform (commit 957aa0d) dan referensi alur kerja DrafTerra (Drawing-Management, commit 1dabb0d).
// Yang diambil dari DrafTerra hanya logic, alur kerja dan role. Stack, UI, autentikasi dan brand tidak dibawa.
{
  "meta": {
    "version": "1.0",
    "date": "2026-11-14",
    "status": "Draf untuk disetujui pemilik produk",
    "app": {
      "id": "drawings",
      "name": "Drawing Database",
      "basePath": "/drawings",
      "devPort": 3004,
      "database": "plant_drawings",
      "packages": ["apps/drawings", "packages/drawings-core", "packages/contracts/src/drawings.ts"],
    },
    "prd": "docs/DRAWING-DATABASE-PRD.md",
    "referenceRepo": "C:\\Users\\a_sfn\\@Project\\Drawing-Management",
  },

  // ───────────────────────── KEPUTUSAN TERKUNCI ─────────────────────────
  "decisions": [
    {
      "id": "K1",
      "text": "Login, sesi, akun, reset password dan grant tetap di Auth/Portal TQ-CMMS. Tidak ada tabel user, login, Request Access atau User Management di aplikasi ini.",
      "source": "instruksi pemilik",
    },
    {
      "id": "K2",
      "text": "UI memakai @plant/ui, token, shell, tema dan pola halaman TQ-CMMS. Tanpa Tailwind, palet atau brand DrafTerra.",
      "source": "instruksi pemilik",
    },
    {
      "id": "K3",
      "text": "Teknologi mengikuti platform: Next.js 16.4.2, React 19.3.1, Drizzle ORM 0.45.4, MySQL 8.4, zod 4.5.4, Node 26.12.1, pnpm 12.14.0.",
      "source": "instruksi pemilik",
    },
    {
      "id": "K4",
      "text": "File di object storage eksternal S3-compatible. Layanan belum disiapkan; pakai abstraksi dengan driver s3 (target) dan fs (development, sementara).",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K5",
      "text": "Data mulai kosong. Tanpa migrasi dari DrafTerra. Drawing lama lewat Upload Old Drawing.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K6",
      "text": "Stamp approval di halaman 1, dibuat sekali saat Completed dari data approval. File asli tidak diubah. Tidak dapat dimatikan approver.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K7",
      "text": "Final Drawing tetap tersedia selama revisi berikutnya diproses.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K8",
      "text": "Maker-checker: pembuat tidak dapat Check/Approve drawing sendiri, termasuk Admin.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K9",
      "text": "Void dengan alasan menggantikan hapus permanen.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K10",
      "text": "Area dan Discipline berupa master terkelola.",
      "source": "jawaban pemilik 2026-11-14",
    },
    {
      "id": "K11",
      "text": "PDF viewer in-page dari komponen viewer pdfjs-dist, bukan iframe.",
      "source": "instruksi pemilik + temuan referensi",
    },
  ],

  "scope": {
    "in": [
      "Drawing Library (cari, filter, detail)",
      "Create Drawing, edit draft, Submit to Check",
      "Check, approval plan, Approval L1, Final Approval, reject dengan catatan dan lampiran",
      "Revisi baru dari Final Drawing",
      "Upload Old Drawing (Legacy Ready)",
      "Drawing Request (intake, review, assignment, draft)",
      "Tugas saya, notifikasi in-app, ringkasan, kartu Portal",
      "PDF viewer, print dan download Final Drawing",
      "Audit, master Area/Discipline, void, pembatalan revisi",
    ],
    "out": [
      "Autentikasi, Request Access, reset password, account settings, User Management (Auth/Portal)",
      "Notifikasi email",
      "Anotasi PDF, compare revisi, tanda tangan digital legal, integrasi SAP/DMS, mobile native",
      "Migrasi data DrafTerra",
      "Thumbnail PDF sisi server",
    ],
  },

  // ───────────────────────── PERAN DAN IZIN ─────────────────────────
  "access": {
    "grant": { "shape": "{ appId: 'drawings', role }", "rolePerUser": 1, "scope": "tidak ada" },
    "roles": [
      { "api": "viewer", "label": "Viewer", "reference": "CONSUMER" },
      { "api": "drafter", "label": "Drafter", "reference": "DRAFTER" },
      { "api": "leader", "label": "Draft Leader", "reference": "DRAFT_LEADER" },
      { "api": "approver", "label": "Approver L1", "reference": "APPROVER_L1" },
      { "api": "head", "label": "Head", "reference": "HEAD" },
      { "api": "admin", "label": "Admin", "reference": "ADMIN" },
    ],
    // Nilai: true = boleh; "own" = hanya drawing miliknya (owner); "assigned" = hanya yang ditugaskan.
    "permissions": {
      "final.read_print_download": {
        "viewer": true,
        "drafter": true,
        "leader": true,
        "approver": true,
        "head": true,
        "admin": true,
      },
      "wip.read": {
        "viewer": false,
        "drafter": "own",
        "leader": true,
        "approver": true,
        "head": true,
        "admin": true,
      },
      "request.create": {
        "viewer": true,
        "drafter": false,
        "leader": false,
        "approver": true,
        "head": true,
        "admin": true,
      },
      "request.review": {
        "viewer": false,
        "drafter": false,
        "leader": true,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "request.drafter_decision": {
        "viewer": false,
        "drafter": "assigned",
        "leader": false,
        "approver": false,
        "head": false,
        "admin": false,
      },
      "drawing.create_edit_submit": {
        "viewer": false,
        "drafter": "own",
        "leader": false,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "revision.create_from_final": {
        "viewer": false,
        "drafter": "own",
        "leader": false,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "revision.cancel": {
        "viewer": false,
        "drafter": "own",
        "leader": false,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "revision.check": {
        "viewer": false,
        "drafter": false,
        "leader": true,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "revision.reassign_approver": {
        "viewer": false,
        "drafter": false,
        "leader": true,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "revision.approve_l1": {
        "viewer": false,
        "drafter": false,
        "leader": false,
        "approver": "assigned",
        "head": false,
        "admin": "assigned",
      },
      "revision.approve_l2": {
        "viewer": false,
        "drafter": false,
        "leader": false,
        "approver": false,
        "head": "assigned",
        "admin": "assigned",
      },
      "drawing.legacy_upload": {
        "viewer": false,
        "drafter": false,
        "leader": true,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "drawing.transfer_owner": {
        "viewer": false,
        "drafter": false,
        "leader": true,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "drawing.void": {
        "viewer": false,
        "drafter": "own, hanya bila belum pernah submit",
        "leader": false,
        "approver": false,
        "head": false,
        "admin": true,
      },
      "admin.correct_metadata_masters_audit": {
        "viewer": false,
        "drafter": false,
        "leader": false,
        "approver": false,
        "head": false,
        "admin": true,
      },
    },
    "rules": [
      "Approval L1 dan Final Approval hanya oleh assignee revisi. Admin tidak melewati routing.",
      "Maker-checker: owner drawing, pembuat revisi dan submitter siklus berjalan tidak dapat memutus level 0/1/2 dan tidak dapat dipilih sebagai approver. Berlaku untuk Admin. Galat 403 MAKER_CHECKER.",
      "Owner = Drawn by. Hak edit, submit, revisi baru dan pembatalan mengikuti owner, bukan pengunggah.",
      "Viewer hanya membuka revisi final yang berlaku; obsolete dan WIP ditolak termasuk lewat URL langsung.",
      "Izin diperiksa server pada setiap request dari identitas Auth.",
    ],
  },

  // ───────────────────────── ALUR KERJA ─────────────────────────
  "workflow": {
    "revisionStatuses": [
      { "api": "draft", "label": "Draft", "editable": true },
      { "api": "waiting_check", "label": "Waiting Check", "editable": false },
      { "api": "check_rejected", "label": "Check Rejected", "editable": true },
      { "api": "waiting_approval_1", "label": "Waiting Approval L1", "editable": false },
      { "api": "approval_1_rejected", "label": "Approval L1 Rejected", "editable": true },
      { "api": "waiting_approval_2", "label": "Waiting Final Approval", "editable": false },
      { "api": "approval_2_rejected", "label": "Final Approval Rejected", "editable": true },
      { "api": "completed", "label": "Completed", "editable": false },
      { "api": "obsolete", "label": "Obsolete", "editable": false },
      { "api": "cancelled", "label": "Cancelled", "editable": false },
    ],
    "transitions": [
      { "from": [null], "action": "create", "by": ["drafter", "admin"], "to": "draft" },
      {
        "from": ["draft", "check_rejected", "approval_1_rejected", "approval_2_rejected"],
        "action": "submit",
        "by": ["owner", "admin"],
        "to": "waiting_check",
        "effect": "cycle + 1; file wajib",
      },
      {
        "from": ["waiting_check"],
        "action": "check.approve",
        "by": ["leader", "admin"],
        "to": "waiting_approval_1",
        "requires": "approval plan: L1 wajib, L2 opsional; bukan maker",
      },
      {
        "from": ["waiting_check"],
        "action": "check.reject",
        "by": ["leader", "admin"],
        "to": "check_rejected",
        "requires": "catatan; bukan maker",
      },
      {
        "from": ["waiting_approval_1"],
        "action": "l1.approve",
        "by": ["assignee L1"],
        "to": "waiting_approval_2",
        "when": "ada assignee L2",
      },
      {
        "from": ["waiting_approval_1"],
        "action": "l1.approve",
        "by": ["assignee L1"],
        "to": "completed",
        "when": "tanpa assignee L2",
      },
      {
        "from": ["waiting_approval_1"],
        "action": "l1.reject",
        "by": ["assignee L1"],
        "to": "approval_1_rejected",
        "requires": "catatan",
      },
      { "from": ["waiting_approval_2"], "action": "l2.approve", "by": ["assignee L2"], "to": "completed" },
      {
        "from": ["waiting_approval_2"],
        "action": "l2.reject",
        "by": ["assignee L2"],
        "to": "approval_2_rejected",
        "requires": "catatan",
      },
      {
        "from": ["completed"],
        "action": "superseded",
        "by": ["sistem"],
        "to": "obsolete",
        "when": "revisi berikutnya completed, dalam transaksi yang sama",
      },
      {
        "from": ["draft", "check_rejected", "approval_1_rejected", "approval_2_rejected"],
        "action": "cancel",
        "by": ["owner", "admin"],
        "to": "cancelled",
        "requires": "alasan; drawing sudah punya Final Drawing",
      },
      {
        "from": [null],
        "action": "legacy_upload",
        "by": ["leader", "admin"],
        "to": "completed",
        "effect": "source legacy; tanpa approval dan stamp",
      },
    ],
    "onCompleted": [
      "Buat file issued berstempel (source standard) sebelum transaksi",
      "Set releasedRevisionId; revisi rilis sebelumnya menjadi obsolete",
      "Notifikasi owner",
      "Tutup Drawing Request asal bila ini rilis pertama",
    ],
    "approvalPlan": {
      "levels": { "0": "Check (Draft Leader)", "1": "Approval L1 (wajib)", "2": "Final Approval (opsional)" },
      "candidates": { "l1": ["approver", "admin"], "l2": ["head", "admin"] },
      "reassign": [
        "Oleh leader/admin selama waiting_approval_1 atau waiting_approval_2",
        "L1 tidak dapat diganti setelah L1 diputus",
        "L2 tidak dapat diganti setelah L2 diputus dan tidak dapat dikosongkan saat waiting_approval_2",
      ],
      "inactiveAssignee": "Ditandai 'Approver tidak aktif' dan masuk tugas leader/admin",
    },
    "reject": { "noteRequired": true, "noteMax": 1000, "imagesMax": 3, "returnsTo": "owner" },
    "cycle": "Setiap submit menaikkan siklus. Keputusan dicatat per siklus bersama fileId yang ditinjau. Stamp memakai siklus terakhir.",
    "releasedVsWorking": {
      "pointers": ["drawings.releasedRevisionId", "drawings.currentRevisionId"],
      "oneActiveRevision": true,
      "noticeWhileRevising": "Revisi berikutnya sedang diproses",
      "metadataAfterFirstRelease": "Hanya admin dengan alasan; owner mengubah data revisi (nomor revisi, change note, file)",
    },
    "nextRevisionNo": ["angka → +1", "satu huruf → huruf berikutnya", "lainnya → sufiks -1"],
    "legacy": {
      "by": ["leader", "admin"],
      "fields": [
        "drawingNumber",
        "title",
        "hac",
        "areaId",
        "disciplineId",
        "revisionNo",
        "ownerId (Drawn by)",
        "legacyNote",
        "fileId",
      ],
      "ownerRule": "Pengguna aktif ber-role drafter, atau pengunggah sendiri",
      "badge": "Legacy Ready",
    },
    "request": {
      "statuses": [
        "pending_review",
        "review_rejected",
        "waiting_drafter_acceptance",
        "drafter_rejected",
        "in_progress",
        "closed",
      ],
      "numberFormat": "DRQ-YYYY-NNNNNN (tahun WIB, sekuens per tahun)",
      "fields": {
        "hac": "wajib",
        "areaId": "wajib",
        "description": "1–2000",
        "purpose": "1–1000",
        "images": "maks 3",
      },
      "steps": [
        "viewer/approver/head/admin membuat request → pending_review",
        "leader/admin: reject (alasan) → review_rejected; assign drafter → waiting_drafter_acceptance",
        "drafter: reject (alasan) → drafter_rejected (kembali ke leader); accept → in_progress + drawing draft",
        "Draft hasil request: hac, area, description terisi; nomor, nama, discipline, file kosong sampai dilengkapi",
        "Revisi pertama completed → closed (selesai). Drawing void → closed (alasan)",
        "Pemohon boleh membatalkan saat pending_review → closed",
      ],
      "visibility": {
        "requester": "miliknya",
        "drafter": "yang ditugaskan",
        "leader": "semua",
        "admin": "semua",
      },
    },
    "void": {
      "drawing": "admin, alasan 1–500; owner hanya bila belum pernah submit. Tersembunyi kecuali filter Dibatalkan (admin). Data, file, audit tetap. Nomor dapat dipakai lagi. Tanpa pengaktifan kembali.",
      "noDeleteEndpoints": true,
    },
    "tasks": {
      "derivedFromState": true,
      "drafter": [
        "approval_2_rejected",
        "approval_1_rejected",
        "check_rejected",
        "draft",
        "request waiting_drafter_acceptance",
      ],
      "leader": [
        "waiting_check",
        "request pending_review",
        "request drafter_rejected",
        "approver tidak aktif",
      ],
      "approver": ["waiting_approval_1 yang ditugaskan"],
      "head": ["waiting_approval_2 yang ditugaskan"],
      "admin": ["gabungan antrean leader", "approval yang ditugaskan", "draft miliknya"],
    },
    "notifications": {
      "perRecipient": [
        "revisi ditolak → owner",
        "drawing completed → owner",
        "ditugaskan sebagai approver → assignee",
        "request ditugaskan → drafter",
        "request ditolak / diterima / selesai → pemohon",
      ],
      "dedupe": "source_key unik",
      "readState": "server",
      "email": false,
    },
  },

  // ───────────────────────── DATA ─────────────────────────
  "data": {
    "fields": {
      "drawingNumber": "1–100, unik di antara drawing tidak void; boleh kosong hanya pada draft hasil request",
      "title": "1–255",
      "hac": "wajib, 1–40, trim + kapital + buang prefiks TQ. (normalizeHec); saran dari nilai yang ada",
      "areaId": "wajib, master",
      "disciplineId": "wajib saat submit, master",
      "description": "opsional, maks 2000",
      "revisionNo": "1–20 [A-Za-z0-9.-], default 0, unik per drawing di antara revisi tidak cancelled",
      "changeNote": "opsional, maks 1000",
      "file": "satu PDF per revisi; wajib saat submit dan legacy",
    },
    "masters": {
      "disciplinesSeed": ["Mechanical", "Piping", "Structural", "Electrical", "Instrumentation", "Civil"],
      "areasSeed": [],
      "deactivated": "tetap tampil pada data lama, tidak dapat dipilih untuk data baru",
    },
    "concurrency": {
      "aggregateRoot": "drawings.version",
      "expectedVersion": "wajib pada setiap mutasi entitas yang sudah ada; usang → 409 VERSION_CONFLICT",
      "idempotencyKey": {
        "header": "Idempotency-Key",
        "pattern": "^[A-Za-z0-9._:-]{8,128}$",
        "scope": "per actor",
        "requiredOn": "POST yang membuat data atau memindahkan status",
      },
      "lockOrder": ["drawings", "drawing_revisions", "revision_approval_steps"],
      "noFileIoInTransaction": true,
    },
    "tables": {
      "areas": "nama unik, aktif, urutan, versi",
      "disciplines": "nama unik, aktif, urutan, versi",
      "drawings": "nomor, nama, hac, area, discipline, deskripsi, owner, uploader, source, legacy note, currentRevisionId, releasedRevisionId, work status, request asal, void, versi",
      "drawing_revisions": "drawing, nomor revisi, status, siklus, file kerja, file issued, change note, submitter, waktu submit/completed/obsolete, pembatalan",
      "revision_approval_steps": "revisi, level 1/2, assignee, penugas; unik revisi+level",
      "approval_actions": "revisi, siklus, level 0/1/2, keputusan, catatan, actor, role, file ditinjau; unik revisi+siklus+level",
      "drawing_files": "jenis, tujuan, storage key, nama asli, MIME, ukuran, sha256, halaman, status staged/attached/orphaned, pemilik, rujukan",
      "drawing_requests": "nomor, pemohon, hac, area, deskripsi, keperluan, status, reviewer, drafter, catatan, drawing hasil, alasan tutup, versi",
      "drawing_sequences": "sekuens nomor request per tahun",
      "drawing_notifications": "penerima, jenis, judul, isi, tautan, source_key unik, dibaca",
      "drawing_audit": "actor, aksi, target, drawing terkait, detail JSON, waktu",
      "drawing_idempotency": "actor, key, hash payload, respons; unik actor+key",
    },
    "conventions": [
      "ID varchar(36); waktu timestamp(3) UTC; tampilan WIB",
      "Nama actor sebagai snapshot; tanpa FK lintas database",
      "Keunikan bersyarat memakai kolom generated (generatedAlwaysAs) berindeks unik",
      "Runtime hanya DML; migrasi lewat job migrate dengan kredensial DDL",
    ],
  },

  // ───────────────────────── FILE, STORAGE, STAMP ─────────────────────────
  "files": {
    "upload": {
      "endpoint": "POST /drawings/api/uploads?kind=pdf|image",
      "body": "biner beraliran; header Content-Type, Content-Length, X-File-Name (percent-encoded)",
      "result": "{ fileId, name, size, sha256, pageCount } berstatus staged",
      "attach": "Mutasi JSON merujuk fileId; server memeriksa staged + pemilik + jenis, lalu attached",
      "pdfValidation": [
        "tipe + magic bytes %PDF-",
        "ukuran ≤ DRAWINGS_MAX_PDF_MB (default 25)",
        "dapat di-parse, ≥ 1 halaman",
        "tidak terenkripsi",
        "lolos uji stamp di memori",
      ],
      "imageValidation": [
        "JPEG/PNG/WebP berdasarkan magic bytes",
        "≤ 5 MB",
        "maks 3 per request atau keputusan",
        "SVG ditolak",
      ],
      "cleanup": "staged > 24 jam dan file draft yang diganti sebelum pernah submit dibersihkan; file yang pernah submit permanen",
    },
    "storage": {
      "interface": ["put", "get(range)", "head", "delete"],
      "drivers": {
        "s3": {
          "use": "target produksi",
          "library": "@aws-sdk/client-s3",
          "config": [
            "endpoint",
            "region",
            "bucket",
            "forcePathStyle",
            "requestChecksumCalculation: WHEN_REQUIRED",
            "responseChecksumValidation: WHEN_REQUIRED",
          ],
          "bucket": "privat, tanpa ACL publik, tanpa presigned URL ke browser",
        },
        "fs": {
          "use": "development, CI, sementara sampai bucket siap",
          "path": "/data/drawings (volume drawings-files)",
        },
      },
      "keys": "files/<tahun>/<fileId>.pdf; dibuat server; tidak pernah ditimpa",
      "egress": "Jaringan private bersifat internal. Driver s3 butuh jaringan egress khusus layanan drawings, tanpa port terbuka; batasi lewat firewall host.",
      "cli": {
        "drawings:storage-copy": "salin fs → s3, verifikasi SHA-256, dapat diulang",
        "drawings:reconcile": "bandingkan tabel file dengan storage, read-only",
      },
    },
    "serving": {
      "endpoint": "GET /drawings/api/revisions/:id/file?disposition=inline|attachment&intent=view|print|download",
      "selection": "issued untuk completed/obsolete; file kerja untuk status lain",
      "range": "206 + Content-Range; tidak valid → 416",
      "headers": [
        "Accept-Ranges: bytes",
        "Content-Length",
        "ETag dari sha256",
        "Cache-Control: private, no-store",
        "X-Content-Type-Options: nosniff",
        "tanpa Content-Encoding",
      ],
      "downloadName": "<DrawingNumber>_Rev-<n>.pdf",
      "downloadPrint": "hanya completed; dicatat audit file.downloaded / file.printed",
      "attachments": "GET /drawings/api/attachments/:id dengan izin induk",
    },
    "stamp": {
      "when": "revisi source standard menjadi completed",
      "output": "file issued terpisah; file asli tidak berubah",
      "geometry": {
        "page": 1,
        "anchor": "kiri-bawah visual",
        "heightPt": 60,
        "widthPt": "128–168",
        "marginPt": 24,
        "gapPt": 10,
        "slots": ["Check", "Approval L1", "Final Approval"],
        "rotation": [0, 90, 180, 270],
      },
      "content": ["judul level", "nama", "role", "waktu keputusan WIB (Asia/Jakarta eksplisit)"],
      "excluded": ["catatan keputusan"],
      "font": "WinAnsi; karakter di luar itu diganti",
      "order": [
        "validasi izin",
        "buat file issued",
        "transaksi database",
        "bersihkan file bila transaksi gagal",
      ],
      "pdfJobsConcurrency": 1,
      "library": "pdf-lib 1.17.1 (referensi) atau @cantoo/pdf-lib; pilih dan pin saat implementasi",
      "portFrom": "Drawing-Management/src/server/storage/pdf-signature.ts",
    },
  },

  // ───────────────────────── PDF VIEWER ─────────────────────────
  "viewer": {
    "library": "pdfjs-dist (referensi memakai 5.6.205); pin persis",
    "components": ["PDFViewer", "EventBus", "PDFLinkService", "PDFFindController"],
    "notUsed": {
      "react-pdf": "hanya render halaman + skala",
      "iframe": "diblokir X-Frame-Options: DENY dan frame-ancestors 'none'",
    },
    "loading": {
      "source": "getDocument({ url }) ke endpoint file same-origin dengan range request",
      "assets": {
        "cMapUrl": "/drawings/pdfjs/cmaps/",
        "standardFontDataUrl": "/drawings/pdfjs/standard_fonts/",
        "wasmUrl": "/drawings/pdfjs/wasm/",
        "iccUrl": "/drawings/pdfjs/iccs/",
      },
      "worker": "new URL('pdfjs-dist/build/pdf.worker.min.mjs', import.meta.url)",
      "ssr": "next/dynamic { ssr: false } dari Client Component",
      "disabled": ["enableXfa", "scripting"],
    },
    "features": {
      "zoom": {
        "min": 0.1,
        "max": 8,
        "presets": ["auto", "page-width", "page-fit", "100%"],
        "gestures": ["Ctrl/Cmd+scroll di kursor", "pinch"],
        "keys": ["+", "-", "0"],
      },
      "navigation": [
        "indikator + lompat halaman",
        "sebelumnya/berikutnya",
        "PgUp/PgDn",
        "Home/End",
        "drag untuk geser",
      ],
      "tools": [
        "putar 90°",
        "cari teks + jumlah hasil",
        "layar penuh",
        "buka di tab baru",
        "download (sesuai izin)",
        "print (sesuai izin)",
      ],
      "render": ["hanya halaman terlihat", "text layer", "detail view untuk zoom tinggi"],
      "watermark": "overlay CSS untuk revisi belum final, obsolete, cancelled",
      "print": "tab baru ke file completed (disposition=inline&intent=print)",
    },
    "states": [
      "skeleton + progres",
      "galat 403/404/413/503/PDF rusak + coba lagi",
      "kosong bila revisi belum berfile",
    ],
    "a11y": [
      "operasi keyboard penuh",
      "label tiap tombol",
      "fokus terlihat",
      "target sentuh ≥ 44 px",
      "reduced motion",
      "tidak menimpa Ctrl/Cmd+K dan Ctrl/Cmd+B",
    ],
    "lifecycle": "destroy loadingTask dan dokumen saat unmount atau ganti revisi",
    "assetsScript": "salin cmaps, standard_fonts, wasm, iccs ke apps/drawings/public/pdfjs/ di awal dev dan build; tidak di-commit",
  },

  // ───────────────────────── PLATFORM ─────────────────────────
  "platform": {
    "changes": {
      "apps/drawings": "baru; Next standalone, basePath /drawings",
      "packages/drawings-core": "baru; schema, migrasi, service, storage, stamp, idempotensi, audit",
      "packages/contracts": "drawings.ts; Grant + DrawingsGrant; appCatalog drawings → active + path + portalSummary",
      "packages/auth-core": "decodeGrant, setAppGrant, setApplicationStatus menerima drawings; direktori pengguna per aplikasi/role",
      "apps/auth": "internal/verify mengenali drawings; GET /auth/internal/directory?app=drawings (token layanan)",
      "packages/server": "pembaca body biner beraliran dengan batas ukuran",
      "packages/ui": "Workspace active 'drawings', grup navigasi, sumber activity/discovery",
      "apps/portal": "form Akses Drawing Database; kartu Portal aktif",
      "infra + compose": "layanan drawings, database/user plant_drawings, volume drawings-files, route + CSP Nginx, batas upload gateway dan host, backup, direktori /data/drawings milik node",
      "scripts": "provisioning database (pola provisionConsumables), migrate, bootstrap, dev, prepare-test, backup, uji operasi, storage-copy, reconcile, penyalin aset PDF.js",
      "ci": "stack uji memuat drawings; MinIO hanya untuk uji driver s3",
    },
    "authDataMigration": {
      "id": "drawings-v1",
      "does": ["status katalog planned → active", "isi path", "role admin untuk akun bootstrap"],
    },
    "gateway": {
      "routes": [
        "upstream drawings",
        "/_verify_drawings",
        "/drawings/_next/",
        "/drawings/favicon.svg",
        "/drawings/api/uploads",
        "/drawings/api/",
        "^/drawings(?:/|$)",
        "blokir /drawings/internal dan /drawings/health",
      ],
      "uploadBody": {
        "location": "= /drawings/api/uploads",
        "clientMaxBodySize": "30m",
        "applyTo": ["infra/nginx/default.conf.template", "infra/deploy/nginx-host.https.conf"],
        "currentGlobal": "128k",
      },
      "csp": {
        "appliesTo": ["/drawings/_next/", "/drawings/api/", "halaman /drawings"],
        "add": [
          "script-src 'wasm-unsafe-eval'",
          "worker-src 'self' blob:",
          "img-src 'self' data: blob:",
          "font-src 'self' data:",
        ],
        "notes": [
          "Worker memakai CSP dari respons skrip worker, jadi /_next/ ikut diberi kebijakan ini",
          "add_header di lokasi membatalkan pewarisan; deklarasikan ulang semua header keamanan lewat satu include",
          "Pertahankan teks connect-src 'self' untuk penggantian HMR di scripts/dev.ts",
        ],
      },
    },
    "api": {
      "base": "/drawings/api",
      "contract": [
        "identitas dari cookie sesi",
        "Origin = PUBLIC_ORIGIN untuk tulis",
        "no-store",
        "galat { error, code }",
        "tanggal ISO UTC",
        "cursor 50",
      ],
      "get": [
        "/portal-summary",
        "/dashboard?year=",
        "/activity",
        "/discovery?q=",
        "/tasks",
        "/tasks/count",
        "/drawings?tab=&q=&status=&areaId=&disciplineId=&ownerId=&revision=&from=&to=&cursor=",
        "/drawings/:id",
        "/drawings/:id/timeline?cursor=",
        "/revisions/:id/file",
        "/attachments/:id",
        "/requests?scope=&status=&cursor=",
        "/requests/:id",
        "/people?for=",
        "/masters",
        "/hac-suggestions?q=",
        "/notifications?filter=&cursor=",
        "/audit?cursor=",
      ],
      "write": [
        "POST /uploads?kind=",
        "POST /drawings",
        "POST /drawings/legacy",
        "PATCH /drawings/:id",
        "POST /drawings/:id/revisions",
        "POST /drawings/:id/void",
        "POST /drawings/:id/owner",
        "POST /revisions/:id/submit",
        "POST /revisions/:id/check",
        "POST /revisions/:id/approve-l1",
        "POST /revisions/:id/approve-l2",
        "POST /revisions/:id/cancel",
        "PATCH /revisions/:id/approval-plan",
        "POST /requests",
        "POST /requests/:id/review",
        "POST /requests/:id/drafter-decision",
        "POST /requests/:id/cancel",
        "POST /notifications/read",
        "POST|PATCH /masters/areas[/:id]",
        "POST|PATCH /masters/disciplines[/:id]",
      ],
      "errorCodes": [
        "VERSION_CONFLICT",
        "INVALID_TRANSITION",
        "NOT_ASSIGNEE",
        "MAKER_CHECKER",
        "FILE_REQUIRED",
        "FILE_INVALID",
        "STORAGE_UNAVAILABLE",
      ],
    },
    "env": [
      "DRAWINGS_DB_PASSWORD",
      "DRAWINGS_DATABASE_URL",
      "DRAWINGS_MIGRATION_DATABASE_URL",
      "DRAWINGS_STORAGE_DRIVER",
      "DRAWINGS_STORAGE_PATH",
      "DRAWINGS_S3_ENDPOINT",
      "DRAWINGS_S3_REGION",
      "DRAWINGS_S3_BUCKET",
      "DRAWINGS_S3_ACCESS_KEY_ID",
      "DRAWINGS_S3_SECRET_ACCESS_KEY",
      "DRAWINGS_S3_FORCE_PATH_STYLE",
      "DRAWINGS_MAX_PDF_MB",
    ],
    "operations": {
      "vpsBudget": {
        "memLimit": "768m",
        "nodeMaxOldSpace": 512,
        "note": "aplikasi lain 512m/320; uji dengan PDF 25 MB sebelum final",
      },
      "backup": {
        "database": "tambah plant_drawings ke backup.sh, database-backup.mjs dan uji restore",
        "files": { "s3": "versioning + retensi bucket", "fs": "arsip harian volume, retensi 14 hari" },
      },
      "health": ["/drawings/health/live", "/drawings/health/ready (database + Auth)"],
      "storageFailure": "503 STORAGE_UNAVAILABLE; tidak menjatuhkan readiness",
      "runbook": "docs/deployment/DRAWING-DATABASE-RELEASE.md",
    },
  },

  // ───────────────────────── UI ─────────────────────────
  "ui": {
    "components": [
      "Shell",
      "Heading",
      "Select",
      "Input",
      "Textarea",
      "Overlay",
      "Toast",
      "useConfirmation",
      "skeleton",
      "token packages/ui/src/tokens.css",
    ],
    "wording": "Istilah domain mengikuti UI_WORDING_GUIDE DrafTerra; kalimat penjelas Bahasa Indonesia",
    "nav": [
      { "label": "Ringkasan", "path": "/drawings", "roles": "semua" },
      { "label": "Drawing Library", "path": "/drawings/library", "roles": "semua" },
      {
        "label": "Tugas saya",
        "path": "/drawings/tasks",
        "roles": "semua selain viewer",
        "badge": "jumlah tugas",
      },
      { "label": "Drawing Requests", "path": "/drawings/requests", "roles": "semua" },
      { "label": "Create Drawing", "path": "/drawings/new", "roles": ["drafter", "admin"] },
      { "label": "Upload Old Drawing", "path": "/drawings/legacy", "roles": ["leader", "admin"] },
      { "label": "Pengelolaan", "path": "/drawings/manage", "roles": ["admin"] },
      { "label": "Audit", "path": "/drawings/audit", "roles": ["admin"] },
    ],
    "pages": [
      "/drawings/library/[id]",
      "/drawings/library/[id]/edit",
      "/drawings/library/[id]/review",
      "/drawings/view/[revisionId]",
      "/drawings/requests/new",
      "/drawings/requests/[id]",
    ],
    "summary": {
      "layout": ".dashboard-grid",
      "hero": "Final Drawing terbit per kuartal (tahun WIB)",
      "kpi": ["Final Drawing", "Dalam proses", "Menunggu tindakan", "Ditolak"],
      "viewer": "hanya angka Final Drawing",
    },
    "library": {
      "tabs": ["Final", "Dalam proses", "Dibatalkan (admin)"],
      "search": ["nomor", "nama", "HAC/SAC", "area"],
      "filters": ["status", "area", "discipline", "owner", "revisi", "rentang tanggal WIB"],
      "views": { "default": "daftar ringkas", "optional": "kartu" },
    },
    "review": "viewer besar + panel keputusan; vertikal di bawah 960 px",
    "statusTones": {
      "draft": "netral",
      "waiting_*": "netral + ikon jam",
      "*_rejected": "pumpkin",
      "completed": "lime",
      "obsolete": "teredam",
      "cancelled": "teredam",
      "rule": "tidak menambah palet; arti selalu lewat label teks",
    },
    "responsive": ["terang/gelap", "390 px dan 1440 px", "keyboard", "reduced motion"],
  },

  // ───────────────────────── PENERIMAAN ─────────────────────────
  "acceptance": {
    "access": [
      "SSO, logout, sesi kedaluwarsa, akun nonaktif",
      "tanpa grant → 403 halaman dan API",
      "header identitas palsu diabaikan",
      "setiap sel matriks izin teruji, termasuk URL langsung file/lampiran",
    ],
    "workflow": [
      "jalur tanpa L2 dan dengan L2 sampai completed",
      "reject tiap level → owner → submit ulang; siklus bertambah",
      "maker-checker menolak owner, pembuat revisi, submitter di tiga level, termasuk admin",
      "bukan assignee ditolak; aturan ganti approver",
      "Final Drawing lama tetap dapat dibuka viewer sampai revisi baru completed, lalu obsolete",
      "legacy completed tanpa stamp dan tanpa keputusan",
      "semua cabang request; in_progress tertutup saat drawing terbit",
      "void dan pembatalan revisi mempertahankan data; nomor dapat dipakai lagi",
    ],
    "integrity": [
      "dua keputusan bersamaan: satu berhasil, satu 409",
      "retry key sama tidak menggandakan; payload berbeda 409",
      "tanpa perubahan sebagian saat gagal",
    ],
    "files": [
      "upload 25 MB lewat gateway berhasil; lebih besar ditolak jelas",
      "bukan PDF, PDF terenkripsi, SVG ditolak",
      "206 benar pada fs dan s3",
      "stamp benar pada rotasi 0/90/180/270 dan waktu WIB",
      "sha256 file asli tidak berubah",
    ],
    "viewer": [
      "A1/A0 zoom sampai 800% tanpa membekukan tab",
      "cari, putar, layar penuh, keyboard",
      "tanpa pelanggaran CSP",
      "Chromium dan WebKit; terang/gelap; 390 dan 1440 px",
      "print/download hanya completed dan tercatat",
      "tab baru berfungsi di Chrome, Edge, Firefox, Safari",
    ],
    "operations": [
      "upgrade tanpa mengubah data Bag Filter/Consumables",
      "backup/restore mencakup plant_drawings",
      "restart tidak menghilangkan file",
      "typecheck, unit, integrasi, E2E, uji operasi, format:check lulus",
      "hasil aktual di docs/VALIDATION.md",
    ],
  },

  // ───────────────────────── FASE IMPLEMENTASI ─────────────────────────
  "phases": [
    {
      "id": 1,
      "name": "Fondasi dan akses",
      "delivers": [
        "kontrak role/grant/katalog",
        "auth-core + direktori",
        "database + provisioning + migrasi",
        "apps/drawings kosong dengan Shell + health",
        "Compose + Nginx",
        "form akses Portal",
        "stack dev dan uji",
      ],
      "doneWhen": "login → /drawings sesuai role; tanpa grant 403; uji platform yang ada tetap lulus",
    },
    {
      "id": 2,
      "name": "File dan viewer",
      "delivers": [
        "storage fs + s3 (MinIO di stack uji)",
        "upload dua tahap",
        "endpoint file + Range",
        "batas body gateway dan host",
        "CSP /drawings",
        "viewer",
      ],
      "doneWhen": "PDF diunggah dan dibuka lewat gateway HTTPS tanpa pelanggaran CSP",
    },
    {
      "id": 3,
      "name": "Drawing inti",
      "delivers": [
        "master",
        "Create Drawing + edit draft",
        "Upload Old Drawing",
        "Library + filter + pagination",
        "detail + riwayat + jejak aktivitas",
        "void",
        "alih owner",
        "audit",
      ],
      "doneWhen": "legacy tampil bagi viewer; visibilitas per role lulus integrasi",
    },
    {
      "id": 4,
      "name": "Alur approval",
      "delivers": [
        "submit",
        "check + approval plan",
        "L1",
        "Final Approval",
        "reject + lampiran",
        "siklus",
        "maker-checker",
        "ganti approver",
        "stamp + issued",
        "obsolete",
        "revisi baru",
        "pembatalan revisi",
        "Tugas saya",
      ],
      "doneWhen": "kriteria alur dan integritas lulus, termasuk konkurensi",
    },
    {
      "id": 5,
      "name": "Request, notifikasi, ringkasan",
      "delivers": [
        "Drawing Request lengkap",
        "notifikasi",
        "dashboard",
        "portal-summary",
        "activity + discovery ke shell",
        "kartu Portal aktif",
      ],
      "doneWhen": "semua cabang request lulus; Portal menampilkan data nyata",
    },
    {
      "id": 6,
      "name": "Pengerasan dan rilis",
      "delivers": [
        "halaman audit",
        "reconcile + storage-copy",
        "backup/restore + uji operasi",
        "E2E penuh",
        "pembaruan README, AGENTS, PRD-v2, API, UI-THEME, OPERATIONS, .env.example",
        "runbook rilis",
        "VALIDATION.md",
        "graph Graphify",
      ],
      "doneWhen": "seluruh kriteria penerimaan lulus pada stack bersih dan pada upgrade",
    },
  ],

  "developerRules": [
    "Tulis rencana singkat dan minta persetujuan sebelum Fase 1",
    "Pakai Context7 sebelum memakai API library; pin versi persis",
    "Perubahan packages/ui dan packages/contracts harus aditif; perilaku aplikasi lain tidak berubah",
    "Migrasi aditif; jangan menyentuh VPS, arsip plant-v2-test PC sumber, atau data nyata",
    "Logic domain sebagai fungsi murni di @plant/contracts dengan unit test",
    "Tanpa I/O file atau jaringan di dalam transaksi database",
    "Rahasia, dump dan file perusahaan tidak masuk Git atau image",
    "Laporan tiap fase memuat perintah yang dijalankan, angkanya, dan hal yang belum diverifikasi",
  ],

  "pitfalls": [
    "init.sh MySQL hanya berjalan pada volume kosong",
    "migrate.ts hanya memperbarui nama katalog",
    "Volume bernama dimiliki root sedangkan image berjalan sebagai node",
    "Worker PDF.js memakai CSP dari respons skripnya sendiri",
    "add_header di lokasi menghapus header yang diwarisi",
    "Content-Encoding pada respons file merusak range request",
    "request.formData() memuat seluruh file ke memori",
    "Font standar pdf-lib gagal pada karakter di luar WinAnsi",
    "Container tidak memakai zona waktu WIB",
  ],

  // ───────────────────────── MASIH TERBUKA ─────────────────────────
  "openQuestions": [
    {
      "id": "Q1",
      "question": "Penyedia object storage, region, kredensial, kebijakan egress; bolehkah go-live sementara dengan fs?",
      "default": "development dengan fs; produksi menunggu keputusan",
    },
    {
      "id": "Q2",
      "question": "Apakah HAC/SAC wajib berformat XXX-XXX seperti Consumables?",
      "default": "format bebas ternormalisasi, 1–40 karakter",
    },
    { "id": "Q3", "question": "Batas ukuran PDF dan anggaran memori VPS", "default": "25 MB; 768 MB" },
    { "id": "Q4", "question": "Daftar awal Area", "default": "kosong, diisi admin" },
    {
      "id": "Q5",
      "question": "Penyesuaian terhadap referensi di luar K7–K10 (alur request, owner, admin review)",
      "default": "diterapkan seperti PRD §12",
    },
  ],

  "futureSuggestions": [
    "Metadata per revisi",
    "Satu orang satu tahap per revisi",
    "Field WO opsional",
    "Ukuran kertas, skala, jenis drawing",
    "Batas waktu approval + delegasi",
    "Notifikasi email",
    "Lembar approval terpisah",
    "Tautan HAC/SAC ke Bag Filter atau Consumables",
  ],

  "unverified": [
    "Versi terbaru pdfjs-dist, pdf-lib/@cantoo/pdf-lib, @aws-sdk/client-s3 di registry npm",
    "Perilaku tab PDF bawaan tiap browser terhadap header keamanan gateway",
    "Kebutuhan memori nyata untuk PDF 25 MB",
  ],

  "context7": [
    "/vercel/next.js",
    "/mozilla/pdf.js",
    "/wojtekmaj/react-pdf",
    "/cantoo-scribe/pdf-lib",
    "/hopding/pdf-lib",
    "/drizzle-team/drizzle-orm-docs",
    "/aws/aws-sdk-js-v3",
    "/websites/nginx_en",
  ],
}
